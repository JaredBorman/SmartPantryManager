<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/ingredientTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="17sp" android:textColor="#173D2D"/>
    <TextView android:id="@+id/ingredientDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#53665A" android:paddingTop="3dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/editIngredient" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Edit"/>
        <Button android:id="@+id/deleteIngredient" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Delete"/>
    </LinearLayout>
</LinearLayout>
